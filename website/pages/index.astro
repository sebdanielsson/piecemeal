---
import { Image } from "astro:assets";
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";
import listDark from "../assets/screens/list-dark.png";
import listLight from "../assets/screens/list-light.png";
import mobileDark from "../assets/screens/mobile-dark.png";
import mobileLight from "../assets/screens/mobile-light.png";
import piecesDark from "../assets/screens/pieces-dark.png";
import piecesLight from "../assets/screens/pieces-light.png";

const { config } = data;
const repo = "https://github.com/sebdanielsson/piecemeal";

const features = [
  {
    title: "A web UI made for the browser",
    body: "Live updates, keyboard shortcuts, filters by state, category, tag and tracker, file priorities and renames, and a live piece map. On a phone too.",
    icon: "M3 5h18v14H3zM3 9h18M8 9v10",
  },
  {
    title: "Users, SSO and scoped keys",
    body: "A local admin, people from any OpenID Connect provider with allowed and admin groups, and API keys for full access, the qBittorrent API, or reading.",
    icon: "M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 21c0-4 4-6 8-6s8 2 8 6",
  },
  {
    title: "RSS with qBittorrent's rules",
    body: "Feeds in folders, and rules with wildcards or regular expressions, episode filters and the smart episode filter. Bring your qBittorrent rules as they are.",
    icon: "M5 19a1 1 0 1 0 0-2 1 1 0 0 0 0 2zM4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16",
  },
  {
    title: "Queueing and seeding goals",
    body: "Limit what downloads and seeds at once. Stop or remove torrents at a ratio, a seeding time or an idle time, per torrent or for all of them.",
    icon: "M4 6h16M4 12h10M4 18h6",
  },
  {
    title: "VPN port forwarding",
    body: "Run inside a WireGuard container and forward the peer port with NAT-PMP. piecemeal follows the port when the VPN changes it.",
    icon: "M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z",
  },
  {
    title: "Built to be operated",
    body: "Prometheus metrics, health and readiness checks, structured logs, an audit log, online backups, and import from Transmission and qBittorrent.",
    icon: "M3 12h4l3-8 4 16 3-8h4",
  },
];

const numbers = [
  { value: "735", unit: "/s", label: "torrents added, with their data in place" },
  { value: "1.0", unit: "s", label: "to verify them all after the last add" },
  { value: "2.2", unit: "%", label: "of one core while idle" },
  { value: "31", unit: "MiB", label: "Go heap in use" },
  { value: "13", unit: "ms", label: "per incremental sync poll, as VueTorrent makes" },
];

const safety = [
  "Save paths confined to the directories you allow, with symlinks resolved",
  "Links from indexers can't reach into your network: private addresses are refused when dialing",
  "Sign-in limits per address, and bounded password hashing",
  "CSRF checks on requests from browsers, and an optional host allowlist",
  "Session tokens and API keys stored only as hashes",
  "Signed images with SBOMs and build provenance",
];

const clients = [
  { name: "piecemeal", version: "1.x" },
  { name: "qBittorrent", version: "5.3" },
  { name: "Transmission", version: "4.1" },
  { name: "Deluge", version: "2.2" },
];
const markLabel = { yes: "Yes", part: "Partly", no: "No" } as const;
type Cell = [keyof typeof markLabel | "text", string?];
const comparison: { feature: string; cells: Cell[] }[] = [
  {
    feature: "Radarr, Sonarr and Prowlarr",
    cells: [["yes", "Yes, as qBittorrent"], ["yes"], ["yes", "Yes, labels as categories"], ["part", "Needs the Label plugin"]],
  },
  {
    feature: "Categories with save paths",
    cells: [["yes"], ["yes"], ["no", "Labels only"], ["part", "Label plugin"]],
  },
  {
    feature: "Web UI on a phone",
    cells: [["yes"], ["part", "Desktop layout"], ["yes"], ["no"]],
  },
  {
    feature: "Users, SSO and scoped API keys",
    cells: [["yes"], ["part", "One account, one full key"], ["no", "One account"], ["part", "Daemon accounts, no SSO"]],
  },
  {
    feature: "RSS with download rules",
    cells: [["yes"], ["yes"], ["no"], ["part", "Third-party plugin"]],
  },
  {
    feature: "Seeding goals",
    cells: [["yes", "Ratio, time, idle"], ["yes", "Ratio, time, idle"], ["part", "Ratio, idle"], ["part", "Ratio"]],
  },
  {
    feature: "Per-torrent speed limits",
    cells: [["no"], ["yes"], ["yes", "Yes, not in the web UI"], ["yes"]],
  },
  {
    feature: "Search engine",
    cells: [["no"], ["yes", "Search plugins"], ["no"], ["no"]],
  },
  {
    feature: "Proxy and I2P",
    cells: [["part", "Proxy, no I2P"], ["yes"], ["no"], ["yes"]],
  },
  {
    feature: "Bind to a VPN interface",
    cells: [["yes"], ["yes"], ["part", "To an address"], ["yes"]],
  },
  {
    feature: "Port forwarding through a VPN",
    cells: [["yes", "NAT-PMP, built in"], ["part", "External script"], ["part", "External script"], ["part", "External script"]],
  },
  {
    feature: "Prometheus metrics, health checks",
    cells: [["yes", "Built in"], ["part", "Third-party exporter"], ["part", "Third-party exporter"], ["part", "Third-party exporter"]],
  },
  {
    feature: "Private trackers with client lists",
    cells: [["no", "Not on the lists"], ["yes", "Widely allowed"], ["yes", "Widely allowed"], ["yes", "Widely allowed"]],
  },
  {
    feature: "Desktop app",
    cells: [["no"], ["yes"], ["yes"], ["yes"]],
  },
  {
    feature: "First released",
    cells: [["text", "2026"], ["text", "2006"], ["text", "2005"], ["text", "2006; no release since April 2025"]],
  },
  {
    feature: "License",
    cells: [["text", "MIT"], ["text", "GPL-2.0+"], ["text", "GPL-2.0 or 3.0"], ["text", "GPL-3.0+"]],
  },
];

const compose = `services:
  piecemeal:
    image: ghcr.io/sebdanielsson/piecemeal:latest
    user: "1000:1000"
    ports:
      - 8080:8080
      - 6881:6881
      - 6881:6881/udp
    environment:
      PIECEMEAL_ADMIN_PASSWORD_HASH: \${PIECEMEAL_ADMIN_PASSWORD_HASH}
    volumes:
      - piecemeal-data:/data
      - /srv/media/downloads:/downloads
    restart: unless-stopped

volumes:
  piecemeal-data:`;
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  banner={config.banner}
  analytics={config.analytics}
  navigation={data.navigation}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  ogImage="/og-home.png"
  ogImageAlt="piecemeal: every piece, in its place. A drop-in qBittorrent for Radarr, Sonarr and Prowlarr, with a web UI and SSO."
  ogImageSize={{ width: 1200, height: 630 }}
  page={{
    title: "piecemeal: a self-hosted BitTorrent client for the *arrs",
    description: config.description,
  }}
>
  <div class="pm">
    <section class="hero wrap">
      <p class="eyebrow">Self-hosted BitTorrent client · Go · MIT</p>
      <h1>Every piece,<br />in its place.</h1>
      <p class="lede">
        piecemeal is a BitTorrent client for your server. It speaks qBittorrent to Radarr, Sonarr and
        Prowlarr, comes with a web UI built for the browser, and signs your household in with SSO. One Go
        binary on <a href="https://github.com/anacrolix/torrent">anacrolix/torrent</a>.
      </p>
      <div class="ctas">
        <a class="button primary" href="/docs/install">Get started</a>
        <a class="button" href="/docs">Read the docs</a>
        <a class="button ghost" href={repo}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z"
            ></path>
          </svg>
          GitHub
        </a>
      </div>
      <button
        class="install"
        type="button"
        data-copy="docker run -p 8080:8080 ghcr.io/sebdanielsson/piecemeal"
        aria-label="Copy the docker run command"
      >
        <span class="prompt">$</span>
        <code>docker run -p 8080:8080 ghcr.io/sebdanielsson/piecemeal</code>
        <span class="copied" aria-live="polite">Copy</span>
      </button>
    </section>

    <section class="wrap" aria-label="A torrent downloading, piece by piece">
      <div class="swarm" data-swarm>
        <div class="swarm-head">
          <div>
            <p class="swarm-name">ubuntu-26.04-desktop-amd64.iso</p>
            <p class="swarm-meta">
              <span class="state"><i></i>Downloading</span>
              <span data-rate>4.7 MiB/s</span>
              <span>6.09 GiB</span>
              <span>1 seed</span>
            </p>
          </div>
          <p class="swarm-pct" data-pct>62.0%</p>
        </div>
        <div class="grid" data-grid></div>
        <p class="legend">
          <span><i class="have"></i>Have <b data-have>0</b></span>
          <span><i class="down"></i>Downloading <b data-down>0</b></span>
          <span><i></i>Missing <b data-missing>0</b></span>
          <span class="legend-note">Piece size 4.00 MiB</span>
        </p>
      </div>
    </section>

    <section class="wrap shot">
      <div class="frame">
        <div class="frame-bar"><span></span><span></span><span></span><em>piecemeal.home.arpa</em></div>
        <Image
          class="only-light"
          src={listLight}
          alt="piecemeal's torrent list in the light theme, with three downloads in progress and five torrents seeding"
          widths={[720, 1440, 2160]}
          sizes="(min-width: 1200px) 1152px, 100vw"
          loading="eager"
        />
        <Image
          class="only-dark"
          src={listDark}
          alt="piecemeal's torrent list in the dark theme, with three downloads in progress and five torrents seeding"
          widths={[720, 1440, 2160]}
          sizes="(min-width: 1200px) 1152px, 100vw"
          loading="eager"
        />
      </div>
    </section>

    <section class="wrap split">
      <div>
        <p class="kicker">A drop-in for the *arrs</p>
        <h2>Speaks qBittorrent, so your stack doesn't change.</h2>
        <p>
          Add piecemeal to Radarr, Sonarr or Prowlarr as a qBittorrent download client, with an API key that
          only works on the qBittorrent API. Categories, save paths, tags and seeding goals behave the way
          they expect.
        </p>
        <ul class="tested">
          <li><b>Radarr 7</b><span>grabs and imports a release through piecemeal in CI</span></li>
          <li><b>Sonarr 4</b><span>download client test in CI</span></li>
          <li><b>Prowlarr 3</b><span>download client test in CI</span></li>
          <li><b>VueTorrent 2.37</b><span>served by piecemeal at <code>/qbittorrent/</code></span></li>
          <li><b>qBittorrent 5.3</b><span>CI compares piecemeal's answers with the real thing</span></li>
        </ul>
        <a class="more" href="/docs/guides/arr">Connect the *arrs →</a>
      </div>
      <div class="client" aria-label="Radarr's download client settings for piecemeal">
        <p class="client-title">Settings › Download Clients › qBittorrent</p>
        <dl>
          <dt>Name</dt><dd>piecemeal</dd>
          <dt>Host</dt><dd><code>piecemeal</code></dd>
          <dt>Port</dt><dd><code>8080</code></dd>
          <dt>API key</dt><dd><code>pm_••••••••••••••••</code></dd>
          <dt>Category</dt><dd><code>radarr</code></dd>
        </dl>
        <p class="client-ok"><i></i>Test succeeded</p>
      </div>
    </section>

    <section class="wrap">
      <p class="kicker">What's inside</p>
      <h2 class="wide">Everything a server's torrent client needs, and nothing it doesn't.</h2>
      <div class="features">
        {
          features.map((f) => (
            <article>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d={f.icon} />
              </svg>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="wrap duo">
      <figure>
        <Image
          class="only-light"
          src={piecesLight}
          alt="A downloading torrent's piece map, in the light theme"
          widths={[720, 1440]}
          sizes="(min-width: 1000px) 760px, 100vw"
        />
        <Image
          class="only-dark"
          src={piecesDark}
          alt="A downloading torrent's piece map, in the dark theme"
          widths={[720, 1440]}
          sizes="(min-width: 1000px) 760px, 100vw"
        />
        <figcaption>Files, peers, trackers and a live piece map for every torrent.</figcaption>
      </figure>
      <figure class="phone">
        <Image class="only-light" src={mobileLight} alt="The torrent list on a phone, in the light theme" widths={[390, 780]} sizes="256px" />
        <Image class="only-dark" src={mobileDark} alt="The torrent list on a phone, in the dark theme" widths={[390, 780]} sizes="256px" />
        <figcaption>The same app on a phone.</figcaption>
      </figure>
    </section>

    <section class="wrap">
      <p class="kicker">Measured, not promised</p>
      <h2 class="wide">A thousand torrents, barely noticed.</h2>
      <div class="numbers">
        {
          numbers.map((n) => (
            <div>
              <p class="num">
                {n.value}
                <span>{n.unit}</span>
              </p>
              <p>{n.label}</p>
            </div>
          ))
        }
      </div>
      <p class="note">
        From <code>test/load</code> with 1,000 torrents on an Apple M5 with an SSD. Run it on your own disks:{" "}
        <a href="/docs/reference/performance">Performance</a>.
      </p>
    </section>

    <section class="wrap split">
      <div>
        <p class="kicker">Safe by default</p>
        <h2>It can write to your disks. It acts like it.</h2>
        <p>
          piecemeal treats every request, every link from an indexer and every torrent as untrusted. It went
          through a security review before 1.0, and the code that reads untrusted input is fuzzed.
        </p>
        <a class="more" href="/docs/reference/security">How piecemeal stays safe →</a>
      </div>
      <ul class="checks">
        {safety.map((s) => <li>{s}</li>)}
      </ul>
    </section>

    <section class="wrap compare">
      <p class="kicker">How it compares</p>
      <h2 class="wide">Pick the right client, even if it isn't this one.</h2>
      <p class="compare-lede">
        piecemeal is built for one job: a server that the *arrs drive. Here's how it measures up against the
        clients most servers run, what it can't do included.
      </p>
      <div class="cmp-scroll" role="region" aria-label="Comparison with qBittorrent, Transmission and Deluge" tabindex="0">
        <table class="cmp">
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Feature</span></th>
              {
                clients.map((c, i) => (
                  <th scope="col" class:list={{ us: i === 0 }}>
                    {c.name}
                    <small>{c.version}</small>
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              comparison.map((row) => (
                <tr>
                  <th scope="row">{row.feature}</th>
                  {row.cells.map(([mark, note], i) => (
                    <td class:list={{ us: i === 0 }}>
                      {mark !== "text" && <span class={`mk ${mark}`} aria-hidden="true" />}
                      {mark !== "text" && note && <span class="sr-only">{markLabel[mark]}: </span>}
                      {mark === "text" ? note : (note ?? markLabel[mark])}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="note">
        qBittorrent 5.3.0, Transmission 4.1.4 and Deluge 2.2.0 as they run on a server, compared from their source and
        documentation in November 2026. Speed and memory aren't compared: there's no fair benchmark of all four.
      </p>
      <a class="more" href="/docs/reference/comparison">The full comparison, feature by feature →</a>
    </section>

    <section class="wrap start">
      <div>
        <p class="kicker">Quick start</p>
        <h2>Running in a minute.</h2>
        <ol>
          <li>Make a password hash: <code>docker run --rm -i ghcr.io/sebdanielsson/piecemeal hash-password</code></li>
          <li>Put it in <code>.env</code> as <code>PIECEMEAL_ADMIN_PASSWORD_HASH</code>, then <code>docker compose up -d</code>.</li>
          <li>Open <code>http://localhost:8080</code> and sign in as <code>admin</code>.</li>
        </ol>
        <p>
          Moving from Transmission or qBittorrent? <a href="/docs/guides/import">Bring your torrents</a>, data and
          all.
        </p>
      </div>
      <div class="code">
        <div class="code-bar">
          <span>compose.yaml</span>
          <button type="button" data-copy={compose} aria-label="Copy compose.yaml">
            <span class="copied" aria-live="polite">Copy</span>
          </button>
        </div>
        <pre><code>{compose}</code></pre>
      </div>
    </section>

    <section class="wrap closing">
      <h2>Ready when your *arrs are.</h2>
      <div class="ctas">
        <a class="button primary" href="/docs/install">Install piecemeal</a>
        <a class="button" href="/reference">API reference</a>
        <a class="button ghost" href={repo}>Star on GitHub</a>
      </div>
    </section>
  </div>
</PageLayout>

<script>
  // Copy buttons.
  for (const el of document.querySelectorAll<HTMLElement>("[data-copy]")) {
    el.addEventListener("click", async () => {
      const label = el.querySelector(".copied");
      try {
        await navigator.clipboard.writeText(el.dataset.copy ?? "");
        if (label) label.textContent = "Copied";
      } catch {
        if (label) label.textContent = "Select it";
      }
      setTimeout(() => {
        if (label) label.textContent = "Copy";
      }, 1600);
    });
  }

  // The piece map: pieces arrive out of order, a dozen in flight at a time, as
  // in the app's Pieces tab.
  const swarm = document.querySelector<HTMLElement>("[data-swarm]");
  const grid = swarm?.querySelector<HTMLElement>("[data-grid]");
  if (swarm && grid) {
    const total = 384;
    const cells: HTMLElement[] = [];
    const frag = document.createDocumentFragment();
    for (let i = 0; i < total; i++) {
      const c = document.createElement("i");
      cells.push(c);
      frag.append(c);
    }
    grid.append(frag);
    const state = new Uint8Array(total); // 0 missing, 1 in flight, 2 have
    const text = (sel: string, v: string) => {
      const el = swarm.querySelector(sel);
      if (el) el.textContent = v;
    };
    const paint = () => {
      let have = 0;
      let down = 0;
      for (let i = 0; i < total; i++) {
        if (state[i] === 2) have++;
        else if (state[i] === 1) down++;
      }
      text("[data-have]", String(have));
      text("[data-down]", String(down));
      text("[data-missing]", String(total - have - down));
      text("[data-pct]", `${((have / total) * 100).toFixed(1)}%`);
    };
    const set = (i: number, s: number) => {
      state[i] = s;
      cells[i].className = s === 2 ? "have" : s === 1 ? "down" : "";
    };
    const reset = (fraction: number) => {
      for (let i = 0; i < total; i++) set(i, Math.random() < fraction ? 2 : 0);
      paint();
    };
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      reset(0.62);
    } else {
      reset(0.62);
      let idle = 0;
      const tick = () => {
        const missing: number[] = [];
        let inFlight = 0;
        for (let i = 0; i < total; i++) {
          if (state[i] === 0) missing.push(i);
          else if (state[i] === 1) inFlight++;
        }
        for (let k = inFlight; k < 12 && missing.length > 0; k++) {
          const i = missing.splice(Math.floor(Math.random() * missing.length), 1)[0];
          set(i, 1);
          setTimeout(
            () => {
              set(i, 2);
              paint();
            },
            500 + Math.random() * 1400,
          );
        }
        text("[data-rate]", `${(4.4 + Math.random() * 0.6).toFixed(1)} MiB/s`);
        paint();
        if (missing.length === 0 && inFlight === 0 && ++idle > 12) {
          idle = 0;
          reset(0.05);
        }
      };
      let timer = 0;
      new IntersectionObserver((entries) => {
        if (entries[0]?.isIntersecting) {
          if (!timer) timer = window.setInterval(tick, 260);
        } else {
          clearInterval(timer);
          timer = 0;
        }
      }).observe(swarm);
    }
  }
</script>

<style>
  .pm {
    --have: oklch(0.56 0.13 155);
    --down: oklch(0.55 0.15 250);
    --line: var(--blume-border);
    --soft: var(--blume-muted-foreground);
    color: var(--blume-foreground);
    font-family: var(--blume-font-body);
    padding-bottom: 6rem;
  }
  :global(:root[data-theme="dark"]) .pm {
    --have: oklch(0.72 0.13 155);
    --down: oklch(0.7 0.13 250);
  }
  :global(:root:not([data-theme="dark"])) .pm :global(.only-dark),
  :global(:root[data-theme="dark"]) .pm :global(.only-light) {
    display: none;
  }
  .wrap {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  section + section {
    margin-top: 7rem;
  }
  h1,
  h2,
  h3 {
    font-family: var(--blume-font-display);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0;
  }
  a {
    color: inherit;
  }
  code {
    font-family: var(--blume-font-mono);
    font-size: 0.875em;
  }

  /* Hero */
  .hero {
    padding-top: 7rem;
  }
  .eyebrow,
  .kicker {
    font-family: var(--blume-font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--soft);
    margin: 0 0 1.25rem;
  }
  .kicker {
    color: var(--have);
  }
  h1 {
    font-size: clamp(3.25rem, 9vw, 7.5rem);
    line-height: 0.95;
    letter-spacing: -0.035em;
  }
  .lede {
